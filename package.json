{
  "name": "m-sixteen",
  "version": "0.2.0",
  "private": true,
  "homepage": "http://michael-lefebvre.github.io/m-sixteen",
  "type": "module",
  "scripts": {
    "dev": "PORT=3004 node server",
    "prebuild": "rm -rf dist/",
    "build": "pnpm run build:static && pnpm run build:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:static": "vite build --ssrManifest .vite/ssr-manifest.json --outDir dist/static",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "pregenerate": "pnpm run build",
    "generate": "node prerender",
    "preview": "cross-env NODE_ENV=production node server",
    "serve": "serve -p 4713 dist/static",
    "prepare": "husky",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "fmt": "prettier -w .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.0.0-rc-cae764ce-20241025",
    "react-dom": "19.0.0-rc-cae764ce-20241025"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/postcss-import": "^14.0.3",
    "@types/react": "npm:types-react@rc",
    "@types/react-dom": "npm:types-react-dom@rc",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "express": "^4.19.2",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.2.0",
    "postcss-preset-env": "^10.0.8",
    "prettier": "3.3.3",
    "sirv": "^2.0.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8"
  },
  "overrides": {
    "@types/react": "npm:types-react@rc",
    "@types/react-dom": "npm:types-react-dom@rc"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19.0.0-rc-cae764ce-20241025"
      }
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,css,md}": "prettier --write"
  }
}